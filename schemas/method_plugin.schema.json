{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://logicpilot.dev/schemas/method-plugin-v1.json",
  "title": "LogicPilot modeling-method plugin manifest",
  "type": "object",
  "required": ["schema", "schemaVersion", "package", "method", "runtimeVersion", "semanticsVersions", "runtime"],
  "properties": {
    "schema": { "const": "logicpilot.method-plugin" },
    "schemaVersion": { "const": 1 },
    "package": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "method": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "runtimeVersion": { "type": "string", "minLength": 1 },
    "semanticsVersions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "runtime": {
      "type": "object",
      "required": ["kind", "entrypoint"],
      "properties": {
        "kind": { "enum": ["linked", "c-abi", "wasm"] },
        "entrypoint": { "type": "string", "minLength": 1 },
        "artifact": { "type": "string" }
      },
      "additionalProperties": true
    },
    "dslLibraries": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": true
}
