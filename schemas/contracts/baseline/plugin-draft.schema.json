{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://logicpilot.dev/schemas/contracts/v1/plugin-draft.schema.json",
  "title": "LogicPilot AI plugin draft contract",
  "description": "A reviewable derived plugin draft. Drafts are data until a user explicitly approves their permission and trust diff.",
  "$defs": {
    "PluginDraftStatus": {
      "type": "string",
      "enum": ["draft", "validated", "approved", "rejected", "published"]
    },
    "PermissionDiff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["added", "removed"],
      "properties": {
        "added": {
          "type": "array",
          "items": { "$ref": "permission-trust.schema.json#/$defs/PermissionId" }
        },
        "removed": {
          "type": "array",
          "items": { "$ref": "permission-trust.schema.json#/$defs/PermissionId" }
        },
        "trustEscalation": {
          "type": "boolean",
          "description": "True when the draft asks for a higher minimum trust level than its base manifest."
        }
      }
    },
    "PluginDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "contractVersion",
        "id",
        "basePluginId",
        "manifest",
        "contributions",
        "status",
        "createdBy",
        "createdAt",
        "permissionDiff"
      ],
      "properties": {
        "schema": { "const": "logicpilot.plugin-draft/v1" },
        "contractVersion": { "const": 1 },
        "id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "basePluginId": { "$ref": "common.schema.json#/$defs/PluginId" },
        "manifest": { "$ref": "plugin-manifest-v2.schema.json#/$defs/PluginManifest" },
        "contributions": {
          "$ref": "plugin-contributions.schema.json#/$defs/PluginContributionSet"
        },
        "status": { "$ref": "#/$defs/PluginDraftStatus" },
        "createdBy": { "$ref": "common.schema.json#/$defs/Actor" },
        "createdAt": { "$ref": "common.schema.json#/$defs/Iso8601Timestamp" },
        "validatedAt": { "$ref": "common.schema.json#/$defs/Iso8601Timestamp" },
        "approvedBy": { "$ref": "common.schema.json#/$defs/Actor" },
        "approvedAt": { "$ref": "common.schema.json#/$defs/Iso8601Timestamp" },
        "permissionDiff": { "$ref": "#/$defs/PermissionDiff" },
        "diagnostics": { "type": "array", "items": { "type": "string", "maxLength": 2048 } }
      }
    }
  }
}
