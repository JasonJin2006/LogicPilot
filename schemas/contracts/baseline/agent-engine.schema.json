{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://logicpilot.dev/schemas/contracts/v1/agent-engine.schema.json",
  "title": "LogicPilot AgentEngine contracts",
  "description": "Agent engines implement runStep/resume/cancel behind this data contract. Tool execution, permissions, artifact transactions and simulation evidence always live outside the engine. BuiltinAgentEngine is the baseline; SDK-backed engines must pass the parity gates before replacing it.",
  "$defs": {
    "AgentEngineId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "ToolDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "parameters"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "description": { "type": "string" },
        "parameters": { "$ref": "common.schema.json#/$defs/JsonSchemaFragment" },
        "requiredPermission": { "$ref": "permission-trust.schema.json#/$defs/PermissionId" },
        "scope": { "type": "string", "description": "Tool scope (document type, artifact kind, ...)." }
      }
    },
    "ToolCall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["callId", "name", "arguments"],
      "properties": {
        "callId": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "arguments": { "$ref": "common.schema.json#/$defs/JsonValue" }
      }
    },
    "ToolResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["callId", "ok", "content"],
      "properties": {
        "callId": { "type": "string", "minLength": 1 },
        "ok": { "type": "boolean" },
        "content": { "$ref": "common.schema.json#/$defs/JsonValue" },
        "error": { "type": "string" }
      }
    },
    "AgentStepRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "contractVersion", "turnId", "engineId", "stepIndex", "input", "tools"],
      "properties": {
        "schema": { "const": "logicpilot.agent-step-request/v1" },
        "contractVersion": { "const": 1 },
        "turnId": { "type": "string", "minLength": 1 },
        "engineId": { "$ref": "#/$defs/AgentEngineId" },
        "stepIndex": { "type": "integer", "minimum": 0 },
        "input": { "$ref": "common.schema.json#/$defs/JsonValue" },
        "tools": {
          "type": "array",
          "description": "Exactly the tools compiled for this step by the context compiler; engines never widen the set.",
          "items": { "$ref": "#/$defs/ToolDescriptor" }
        },
        "compiledContext": { "$ref": "common.schema.json#/$defs/JsonValue" },
        "maxTokens": { "type": "integer", "minimum": 1 }
      }
    },
    "StepStatus": {
      "type": "string",
      "enum": ["continue", "done", "cancelled", "failed"]
    },
    "AgentUsage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inputTokens": { "type": "integer", "minimum": 0 },
        "outputTokens": { "type": "integer", "minimum": 0 },
        "latencyMs": { "type": "integer", "minimum": 0 }
      }
    },
    "AgentCheckpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "contractVersion", "turnId", "engineId", "revision", "state"],
      "properties": {
        "schema": { "const": "logicpilot.agent-checkpoint/v1" },
        "contractVersion": { "const": 1 },
        "turnId": { "type": "string", "minLength": 1 },
        "engineId": { "$ref": "#/$defs/AgentEngineId" },
        "revision": { "type": "integer", "minimum": 0 },
        "state": { "$ref": "common.schema.json#/$defs/JsonValue" },
        "createdAt": { "$ref": "common.schema.json#/$defs/Iso8601Timestamp" }
      }
    },
    "AgentStepResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "contractVersion", "turnId", "engineId", "stepIndex", "status", "toolCalls", "toolResults"],
      "properties": {
        "schema": { "const": "logicpilot.agent-step-result/v1" },
        "contractVersion": { "const": 1 },
        "turnId": { "type": "string", "minLength": 1 },
        "engineId": { "$ref": "#/$defs/AgentEngineId" },
        "stepIndex": { "type": "integer", "minimum": 0 },
        "status": { "$ref": "#/$defs/StepStatus" },
        "message": { "$ref": "common.schema.json#/$defs/JsonValue" },
        "toolCalls": {
          "type": "array",
          "items": { "$ref": "#/$defs/ToolCall" }
        },
        "toolResults": {
          "type": "array",
          "items": { "$ref": "#/$defs/ToolResult" }
        },
        "usage": { "$ref": "#/$defs/AgentUsage" },
        "checkpoint": { "$ref": "#/$defs/AgentCheckpoint" },
        "error": { "type": "string" }
      }
    },
    "AgentEngineDescriptor": {
      "type": "object",
      "description": "Declares an available engine implementation; selection is a host decision.",
      "additionalProperties": false,
      "required": ["schema", "contractVersion", "id", "implementation"],
      "properties": {
        "schema": { "const": "logicpilot.agent-engine-descriptor/v1" },
        "contractVersion": { "const": 1 },
        "id": { "$ref": "#/$defs/AgentEngineId" },
        "implementation": {
          "type": "string",
          "enum": ["builtin", "openai-agents"]
        },
        "config": { "$ref": "common.schema.json#/$defs/JsonValue" }
      }
    }
  }
}
