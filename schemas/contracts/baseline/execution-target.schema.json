{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://logicpilot.dev/schemas/contracts/v1/execution-target.schema.json",
  "title": "LogicPilot execution target contracts",
  "description": "Execution targets bind a semantic model artifact to a runtime provided by a plugin. Runs are revision-bound and archive structured evidence; native crashes and ABI mismatches must surface as structured diagnostics, never corrupt project state.",
  "$defs": {
    "MethodId": {
      "type": "string",
      "description": "Identifier of a semantic method reported by a provider: a paradigm family (process, devs, continuous, agent, ...) or a kernel method name (sd, ...). Open by design - adding a paradigm must not require a contract change, so the id is declared by the pack rather than enumerated here. See docs/adr/0139-open-evidence-method-ids.md.",
      "pattern": "^[a-z][a-z0-9._-]*$",
      "minLength": 1,
      "maxLength": 64
    },
    "ExecutionConformance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "checks"],
      "properties": {
        "passed": { "type": "boolean" },
        "checks": { "$ref": "common.schema.json#/$defs/JsonValue" }
      }
    },
    "ExecutionEvidenceDetails": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "summary"],
      "properties": {
        "kind": { "$ref": "#/$defs/MethodId" },
        "summary": { "$ref": "common.schema.json#/$defs/JsonValue" }
      }
    },
    "RuntimeKind": {
      "type": "string",
      "enum": ["interpreter", "wasm", "native", "external"]
    },
    "RuntimeRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "$ref": "#/$defs/RuntimeKind" },
        "pluginId": { "$ref": "common.schema.json#/$defs/PluginId" },
        "capability": { "$ref": "common.schema.json#/$defs/CapabilityId" }
      }
    },
    "ExecutionTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "contractVersion", "id", "artifactRef", "runtime"],
      "properties": {
        "schema": { "const": "logicpilot.execution-target/v1" },
        "contractVersion": { "const": 1 },
        "id": { "$ref": "common.schema.json#/$defs/CapabilityId" },
        "titleKey": { "$ref": "common.schema.json#/$defs/LocalizedKey" },
        "artifactRef": { "$ref": "artifact-graph.schema.json#/$defs/ArtifactRef" },
        "runtime": { "$ref": "#/$defs/RuntimeRef" },
        "capabilities": {
          "$ref": "execution-session.schema.json#/$defs/ExecutionProviderCapabilities"
        },
        "options": { "$ref": "common.schema.json#/$defs/JsonValue" }
      }
    },
    "ExecutionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxSteps": { "type": "integer", "minimum": 1 },
        "maxWallMs": { "type": "integer", "minimum": 1 }
      }
    },
    "ExecutionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "contractVersion", "requestId", "targetId"],
      "properties": {
        "schema": { "const": "logicpilot.execution-request/v1" },
        "contractVersion": { "const": 1 },
        "requestId": { "type": "string", "minLength": 1 },
        "runId": { "type": "string", "minLength": 1 },
        "targetId": { "$ref": "common.schema.json#/$defs/CapabilityId" },
        "artifactRef": { "$ref": "artifact-graph.schema.json#/$defs/ArtifactRef" },
        "seed": {
          "type": "integer",
          "description": "Deterministic replay requires the seed recorded with the run."
        },
        "inputs": { "$ref": "common.schema.json#/$defs/JsonValue" },
        "budget": { "$ref": "#/$defs/ExecutionBudget" }
      }
    },
    "RunStatus": {
      "type": "string",
      "enum": ["pending", "running", "completed", "failed", "cancelled"]
    },
    "ExecutionRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "contractVersion",
        "runId",
        "requestId",
        "targetId",
        "artifactRef",
        "status"
      ],
      "properties": {
        "schema": { "const": "logicpilot.execution-run/v1" },
        "contractVersion": { "const": 1 },
        "runId": { "type": "string", "minLength": 1 },
        "requestId": { "type": "string", "minLength": 1 },
        "targetId": { "$ref": "common.schema.json#/$defs/CapabilityId" },
        "artifactRef": { "$ref": "artifact-graph.schema.json#/$defs/ArtifactRef" },
        "status": { "$ref": "#/$defs/RunStatus" },
        "seed": { "type": "integer" },
        "evidenceRef": { "$ref": "artifact-graph.schema.json#/$defs/ArtifactRef" },
        "startedAt": { "$ref": "common.schema.json#/$defs/Iso8601Timestamp" },
        "finishedAt": { "$ref": "common.schema.json#/$defs/Iso8601Timestamp" },
        "error": { "type": "string" }
      }
    },
    "ExecutionEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "contractVersion", "runId", "digest"],
      "properties": {
        "schema": { "const": "logicpilot.execution-evidence/v1" },
        "contractVersion": { "const": 1 },
        "runId": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "common.schema.json#/$defs/Sha256Hex" },
        "methods": {
          "type": "array",
          "description": "Semantic methods represented by this evidence; mixed runs list every method instead of inventing one runtime kind.",
          "items": { "$ref": "#/$defs/MethodId" },
          "minItems": 1,
          "uniqueItems": true
        },
        "irDigest": { "$ref": "common.schema.json#/$defs/Sha256Hex" },
        "runtimeKind": { "$ref": "#/$defs/MethodId" },
        "method": { "$ref": "#/$defs/MethodId" },
        "conformance": { "$ref": "#/$defs/ExecutionConformance" },
        "details": { "$ref": "#/$defs/ExecutionEvidenceDetails" },
        "traceRef": { "$ref": "artifact-graph.schema.json#/$defs/ArtifactRef" },
        "metrics": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        }
      }
    }
  }
}
