{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://logicpilot.dev/schemas/contracts/v1/plugin-catalog.schema.json",
  "title": "LogicPilot Plugin Catalog",
  "description": "Validated discovery catalog envelope (Phase 2B-1, ADR-0071). Produced by the Node-side read-only scanner and consumed by browsers through the local bridge. The envelope never carries filesystem paths or file contents; scope is authoritative for the containing root and the catalog is overlay-composed by the host.",
  "$defs": {
    "PluginScope": {
      "type": "string",
      "description": "Discovery layer: system (bundled), user (machine-wide) or workspace.",
      "enum": ["system", "user", "workspace"]
    },
    "PluginCatalogRootId": {
      "type": "string",
      "description": "Stable root identity inside one catalog: '<scope>:<index>' (1-based).",
      "pattern": "^(system|user|workspace):[0-9]+$",
      "minLength": 3,
      "maxLength": 64
    },
    "PluginCatalogPath": {
      "type": "string",
      "description": "Package directory relative to its root, posix-style. Canonical: never absolute, no Windows drive prefix, no backslash, no empty/'.'/'..' segments, no trailing slash.",
      "pattern": "^(?!^/)(?!.*//)(?!.*/$)(?!^[A-Za-z]:)(?!.*(^|/)\\.\\.($|/))(?!^\\.)(?!.*(^|/)\\.($|/))[^\\\\]+$",
      "minLength": 1,
      "maxLength": 256
    },
    "PluginCatalogSeverity": {
      "type": "string",
      "enum": ["error", "warning"]
    },
    "PluginCatalogDiagnosticKind": {
      "type": "string",
      "enum": [
        "json",
        "schema",
        "filesystem",
        "api-version",
        "hash-drift",
        "duplicate-id",
        "dependency",
        "loadable",
        "transport"
      ]
    },
    "PluginCatalogRoot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scope"],
      "properties": {
        "id": { "$ref": "#/$defs/PluginCatalogRootId" },
        "scope": { "$ref": "#/$defs/PluginScope" }
      }
    },
    "PluginCatalogEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scope", "rootId", "path", "sha256", "manifest"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/PluginId" },
        "scope": { "$ref": "#/$defs/PluginScope" },
        "rootId": { "$ref": "#/$defs/PluginCatalogRootId" },
        "path": { "$ref": "#/$defs/PluginCatalogPath" },
        "sha256": { "$ref": "common.schema.json#/$defs/Sha256Hex" },
        "manifest": { "$ref": "plugin-manifest-v2.schema.json#/$defs/PluginManifest" }
      }
    },
    "PluginCatalogDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "kind", "message"],
      "properties": {
        "severity": { "$ref": "#/$defs/PluginCatalogSeverity" },
        "kind": { "$ref": "#/$defs/PluginCatalogDiagnosticKind" },
        "message": { "type": "string", "minLength": 1, "maxLength": 512 },
        "scope": { "$ref": "#/$defs/PluginScope" },
        "rootId": { "$ref": "#/$defs/PluginCatalogRootId" },
        "path": { "$ref": "#/$defs/PluginCatalogPath" },
        "pluginId": { "$ref": "common.schema.json#/$defs/PluginId" }
      }
    },
    "PluginCatalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "contractVersion", "roots", "entries", "diagnostics"],
      "properties": {
        "schema": { "const": "logicpilot.plugin-catalog/v1" },
        "contractVersion": { "const": 1 },
        "roots": { "type": "array", "items": { "$ref": "#/$defs/PluginCatalogRoot" } },
        "entries": { "type": "array", "items": { "$ref": "#/$defs/PluginCatalogEntry" } },
        "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/PluginCatalogDiagnostic" } }
      }
    }
  }
}
