{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://logicpilot.dev/schemas/contracts/v1/artifact-graph.schema.json",
  "title": "LogicPilot artifact graph and unified transaction contracts",
  "description": "All AI and human modifications flow through one revision/transaction/approval protocol. ModelPatch, SysML typed edits, source patches and layout edits keep their own operation schemas but share these envelopes.",
  "$defs": {
    "ArtifactKind": {
      "type": "string",
      "enum": [
        "semantic-model",
        "source-document",
        "view-layout",
        "knowledge-pack",
        "plugin-draft",
        "execution-target",
        "experiment",
        "run",
        "evidence",
        "diagnostic-set",
        "migration-record"
      ]
    },
    "ArtifactId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "RevisionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "ArtifactRef": {
      "type": "object",
      "description": "Reference to an artifact head or a pinned revision.",
      "additionalProperties": false,
      "required": ["artifactId"],
      "properties": {
        "artifactId": { "$ref": "#/$defs/ArtifactId" },
        "revisionId": { "$ref": "#/$defs/RevisionId" }
      }
    },
    "Artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "contractVersion", "id", "kind", "createdAt", "createdBy"],
      "properties": {
        "schema": { "const": "logicpilot.artifact/v1" },
        "contractVersion": { "const": 1 },
        "id": { "$ref": "#/$defs/ArtifactId" },
        "kind": { "$ref": "#/$defs/ArtifactKind" },
        "projectId": { "type": "string", "minLength": 1 },
        "createdAt": { "$ref": "common.schema.json#/$defs/Iso8601Timestamp" },
        "createdBy": { "$ref": "common.schema.json#/$defs/Actor" },
        "metadata": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "TypedOperation": {
      "type": "object",
      "description": "One typed edit inside a revision or transaction. opType selects the operation schema (model-patch, sysml-typed-edit, source-patch, layout-edit, ...); payload carries that schema's structured body.",
      "additionalProperties": false,
      "required": ["opId", "opType", "payload"],
      "properties": {
        "opId": { "type": "string", "minLength": 1 },
        "opType": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "description": "Optional element path inside the artifact." },
        "payload": { "$ref": "common.schema.json#/$defs/JsonValue" }
      }
    },
    "Revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "contractVersion", "id", "artifactId", "createdAt", "createdBy", "operations", "digest"],
      "properties": {
        "schema": { "const": "logicpilot.revision/v1" },
        "contractVersion": { "const": 1 },
        "id": { "$ref": "#/$defs/RevisionId" },
        "artifactId": { "$ref": "#/$defs/ArtifactId" },
        "parentRevisionId": { "$ref": "#/$defs/RevisionId" },
        "createdAt": { "$ref": "common.schema.json#/$defs/Iso8601Timestamp" },
        "createdBy": { "$ref": "common.schema.json#/$defs/Actor" },
        "operations": {
          "type": "array",
          "items": { "$ref": "#/$defs/TypedOperation" }
        },
        "digest": { "$ref": "common.schema.json#/$defs/Sha256Hex" }
      }
    },
    "RelationKind": {
      "type": "string",
      "enum": [
        "projects",
        "executes",
        "validates",
        "produced-by",
        "applies-to",
        "provides",
        "derives-from",
        "supersedes"
      ]
    },
    "Relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "contractVersion", "id", "kind", "from", "to"],
      "properties": {
        "schema": { "const": "logicpilot.relation/v1" },
        "contractVersion": { "const": 1 },
        "id": { "type": "string", "minLength": 1 },
        "kind": { "$ref": "#/$defs/RelationKind" },
        "from": { "$ref": "#/$defs/ArtifactRef" },
        "to": { "$ref": "#/$defs/ArtifactRef" },
        "metadata": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "TransactionStatus": {
      "type": "string",
      "enum": ["proposed", "validated", "awaiting-approval", "committed", "rejected", "rolled-back"]
    },
    "Transaction": {
      "type": "object",
      "description": "Unified transaction envelope: read revision -> propose typed operations -> validate -> preview -> approval -> commit new revision -> derive projections -> compile/run -> rollback.",
      "additionalProperties": false,
      "required": ["schema", "contractVersion", "id", "status", "proposedBy", "artifactRefs", "operations"],
      "properties": {
        "schema": { "const": "logicpilot.transaction/v1" },
        "contractVersion": { "const": 1 },
        "id": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/TransactionStatus" },
        "proposedBy": { "$ref": "common.schema.json#/$defs/Actor" },
        "approvedBy": { "$ref": "common.schema.json#/$defs/Actor" },
        "artifactRefs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ArtifactRef" }
        },
        "operations": {
          "type": "array",
          "items": { "$ref": "#/$defs/TypedOperation" }
        },
        "committedRevisionId": { "$ref": "#/$defs/RevisionId" },
        "createdAt": { "$ref": "common.schema.json#/$defs/Iso8601Timestamp" },
        "resolutionRecord": {
          "type": "string",
          "description": "Structured record id when instruction conflicts were resolved for this transaction."
        }
      }
    }
  }
}
