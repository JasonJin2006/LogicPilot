{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://logicpilot.dev/schemas/contracts/v1/plugin-services.schema.json",
  "title": "LogicPilot plugin service declarations",
  "description": "Manifest-declared service names and method allowlists used by runtime.service.provide/call.",
  "$defs": {
    "PluginServiceMethod": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "input": { "$ref": "common.schema.json#/$defs/JsonSchemaFragment" },
        "output": { "$ref": "common.schema.json#/$defs/JsonSchemaFragment" }
      }
    },
    "PluginService": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "methods"],
      "properties": {
        "name": { "$ref": "common.schema.json#/$defs/CapabilityId" },
        "methods": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/\u0024defs/PluginServiceMethod" }
        }
      }
    }
  }
}
