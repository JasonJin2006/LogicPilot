{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://logicpilot.dev/schemas/contracts/v1/plugin-runtime-session.schema.json",
  "title": "LogicPilot plugin runtime session",
  "description": "Short-lived, generation-bound authorization record for an isolated plugin runtime.",
  "$defs": {
    "PluginRuntimeSession": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "contractVersion",
        "sessionId",
        "pluginId",
        "generation",
        "sha256",
        "trust",
        "grants",
        "expiresAt"
      ],
      "properties": {
        "schema": { "const": "logicpilot.plugin-runtime-session/v1" },
        "contractVersion": { "const": 1 },
        "sessionId": { "type": "string", "minLength": 8, "maxLength": 128 },
        "pluginId": { "$ref": "common.schema.json#/$defs/PluginId" },
        "generation": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "common.schema.json#/$defs/Sha256Hex" },
        "trust": { "$ref": "permission-trust.schema.json#/$defs/TrustLevel" },
        "grants": {
          "type": "array",
          "items": { "$ref": "permission-trust.schema.json#/$defs/PermissionGrant" }
        },
        "expiresAt": { "$ref": "common.schema.json#/$defs/Iso8601Timestamp" }
      }
    }
  }
}
