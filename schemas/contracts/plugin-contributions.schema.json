{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://logicpilot.dev/schemas/contracts/v1/plugin-contributions.schema.json",
  "title": "LogicPilot structured plugin contributions",
  "description": "One strict envelope for plugin-provided knowledge, skills, instructions, diagnostics, views, palettes, tools and run parameters. Domain definitions are reused from their existing contract schemas. runParameters is optional and additive: it declares the knobs a paradigm pack contributes to the run dialog, so the shell never has to hold paradigm vocabulary itself (ownership split in docs/specs/dsl-freeze.md section 3).",
  "$defs": {
    "PluginContributionKind": {
      "type": "string",
      "enum": ["knowledge", "skill", "instruction", "diagnostic", "view", "palette", "tool"]
    },
    "PluginSkillStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "action"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/CapabilityId" },
        "action": { "type": "string", "minLength": 1, "maxLength": 256 },
        "arguments": { "x-freeform-json": true }
      }
    },
    "PluginSkillContribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "trigger", "inputs", "steps", "permissions"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/CapabilityId" },
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "trigger": { "type": "string", "minLength": 1, "maxLength": 512 },
        "inputs": { "type": "array", "items": { "type": "string", "maxLength": 128 } },
        "steps": { "type": "array", "items": { "$ref": "#/$defs/PluginSkillStep" } },
        "permissions": {
          "type": "array",
          "items": { "$ref": "permission-trust.schema.json#/$defs/PermissionId" }
        }
      }
    },
    "PluginInstructionContribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scope", "priority", "rules", "forbidden"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/CapabilityId" },
        "scope": { "type": "string", "minLength": 1, "maxLength": 256 },
        "priority": { "type": "integer", "minimum": -1000, "maximum": 1000 },
        "rules": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 2048 }
        },
        "forbidden": { "type": "array", "items": { "type": "string", "maxLength": 2048 } }
      }
    },
    "PluginPaletteContribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "canvas", "itemKind", "label", "semanticType"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/CapabilityId" },
        "canvas": { "$ref": "view-notation.schema.json#/$defs/CanvasEngineId" },
        "itemKind": { "type": "string", "minLength": 1, "maxLength": 128 },
        "label": { "type": "string", "minLength": 1, "maxLength": 256 },
        "icon": { "type": "string", "maxLength": 256 },
        "semanticType": { "type": "string", "minLength": 1, "maxLength": 256 },
        "defaults": { "$ref": "common.schema.json#/$defs/JsonSchemaFragment" }
      }
    },
    "PluginToolContribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "capability", "inputSchema", "outputSchema", "permissions"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/CapabilityId" },
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "capability": { "$ref": "common.schema.json#/$defs/CapabilityId" },
        "inputSchema": { "$ref": "common.schema.json#/$defs/JsonSchemaFragment" },
        "outputSchema": { "$ref": "common.schema.json#/$defs/JsonSchemaFragment" },
        "permissions": {
          "type": "array",
          "items": { "$ref": "permission-trust.schema.json#/$defs/PermissionId" }
        }
      }
    },
    "PluginRunParameterContribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "kind", "owner"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "label": { "type": "string", "minLength": 1, "maxLength": 128 },
        "kind": { "$ref": "#/$defs/RunParameterKind" },
        "owner": { "$ref": "#/$defs/RunParameterOwner" },
        "hint": { "type": "string", "maxLength": 512 },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "choices": { "type": "array", "items": { "$ref": "#/$defs/RunParameterChoice" } }
      }
    },
    "RunParameterKind": {
      "type": "string",
      "enum": ["integer", "number", "text", "boolean"]
    },
    "RunParameterOwner": {
      "type": "string",
      "enum": ["model", "run"]
    },
    "RunParameterChoice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value"],
      "properties": {
        "value": { "type": "string", "minLength": 1, "maxLength": 128 },
        "label": { "type": "string", "maxLength": 256 }
      }
    },
    "PluginContributionSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "contractVersion",
        "pluginId",
        "version",
        "knowledge",
        "skills",
        "instructions",
        "diagnostics",
        "views",
        "notations",
        "createActions",
        "palettes",
        "tools"
      ],
      "properties": {
        "schema": { "const": "logicpilot.plugin-contributions/v1" },
        "contractVersion": { "const": 1 },
        "pluginId": { "$ref": "common.schema.json#/$defs/PluginId" },
        "version": { "$ref": "common.schema.json#/$defs/SemanticVersion" },
        "knowledge": {
          "type": "array",
          "items": { "$ref": "knowledge-block.schema.json#/$defs/KnowledgeBlock" }
        },
        "skills": { "type": "array", "items": { "$ref": "#/$defs/PluginSkillContribution" } },
        "instructions": {
          "type": "array",
          "items": { "$ref": "#/$defs/PluginInstructionContribution" }
        },
        "diagnostics": {
          "type": "array",
          "items": { "$ref": "diagnostic.schema.json#/$defs/DiagnosticDefinition" }
        },
        "views": {
          "type": "array",
          "items": { "$ref": "view-notation.schema.json#/$defs/ViewDefinition" }
        },
        "notations": {
          "type": "array",
          "items": { "$ref": "view-notation.schema.json#/$defs/NotationPack" }
        },
        "createActions": {
          "type": "array",
          "items": { "$ref": "view-notation.schema.json#/$defs/CreateAction" }
        },
        "palettes": { "type": "array", "items": { "$ref": "#/$defs/PluginPaletteContribution" } },
        "tools": { "type": "array", "items": { "$ref": "#/$defs/PluginToolContribution" } },
        "runParameters": {
          "type": "array",
          "items": { "$ref": "#/$defs/PluginRunParameterContribution" }
        }
      }
    }
  }
}
