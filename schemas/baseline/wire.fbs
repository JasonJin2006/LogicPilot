// LogicPilot wire protocol — WS realtime frame protocol v1.
//
// Contract freeze point F2 (ADR-0004). Streaming frames and control payloads
// between the kernel and web clients. Schema evolution discipline applies:
// NEVER reorder fields, NEVER reuse a removed field id; all fields carry an
// explicit `(id: N)`. Ids are assigned consecutively starting at 0 (flatc
// requirement) and are frozen.
//
// Budget drivers (docs/performance-budget.md): pushed frames <= 1 MB at
// 1M agents @ 10 Hz, end-to-end latency <= 300 ms, zero-copy reads on both
// the C++ and TypeScript sides.

namespace logicpilot.wire;

// Declare the attributes used below (flatc requires attributes to be
// declared before use once any of them is given explicitly).
attribute "id";
attribute "default";

// ---------------------------------------------------------------------------
// Frame kinds & status
// ---------------------------------------------------------------------------

enum FrameKind : ubyte {
  Unknown = 0,
  RunStarted = 1,
  Tick = 2,
  Counters = 3,
  RunFinished = 4,
  // v1 implements exactly the four kinds above; the rest is reserved.
  // Extension kinds MUST append here with fresh ids.
}

enum RunStatus : byte {
  Completed = 0,
  Failed = 1,
  Cancelled = 2,
}

// ---------------------------------------------------------------------------
// Frame header
// ---------------------------------------------------------------------------

// Present on every frame; cheap fixed-size prefix after the flatbuffer root.
table FrameHeader {
  // Wire protocol version (v1 = 1). Consumers must reject unknown versions.
  version: uint32 (id: 0, default: 1);
  // Monotonic per-run frame sequence number.
  seq: uint64 (id: 1);
  // Simulated time of this frame in nanoseconds (wall time never on wire).
  sim_time_ns: int64 (id: 2);
  // Redundant with the payload union tag; lets consumers filter without
  // dereferencing the payload.
  kind: FrameKind (id: 3);
}

// ---------------------------------------------------------------------------
// Messages (FramePayload union members)
// ---------------------------------------------------------------------------

table RunStarted {
  run_id: string (id: 0);
  model_name: string (id: 1);
  seed: uint64 (id: 2);
}

// Per-agent delta. `flags` is a bitset declaring which optional fields are
// meaningful in this delta (positions are floats for render-only precision):
//   bit 0 (0x1): pos_x/pos_y valid
//   bit 1 (0x2): state_bits valid
//   bit 2 (0x4): lod_level valid
//   bit 3 (0x8): keyframe valid
// Bits >= 4 are reserved and MUST be ignored by v1 consumers.
table AgentDelta {
  id: uint64 (id: 0);
  flags: uint32 (id: 1);
  pos_x: float (id: 2);
  pos_y: float (id: 3);
  state_bits: uint64 (id: 4);
  // --- LOD fields (reserved, present in v1 layout, semantics land later) ---
  lod_level: ubyte (id: 5);
  keyframe: bool (id: 6);
}

table Tick {
  sim_time_ns: int64 (id: 0);
  // Optional: absent for ticks that only advance counters.
  deltas: [AgentDelta] (id: 1);
}

table Counter {
  name: string (id: 0);
  value: double (id: 1);
}

table Counters {
  values: [Counter] (id: 0);
}

// Terminal frame of a run; reuses Counter for the stats summary.
table RunFinished {
  run_id: string (id: 0);
  status: RunStatus (id: 1);
  error: string (id: 2);
  stats: [Counter] (id: 3);
}

union FramePayload {
  RunStarted,
  Tick,
  Counters,
  RunFinished,
}

// ---------------------------------------------------------------------------
// Root frame
// ---------------------------------------------------------------------------

table Frame {
  header: FrameHeader (id: 0);
  // Union fields reserve id-1 for the implicit `payload_type` tag.
  payload: FramePayload (id: 2);
}

root_type Frame;
file_identifier "LPWR";
file_extension "lpwr";
