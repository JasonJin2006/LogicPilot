// LogicPilot IR schema — Extended DEVS IR v1.
//
// Contract freeze point F1 (ADR-0004). This is the lowered form of the DSL
// model consumed by the kernel, the DSL compiler output, and persisted model
// files. Schema evolution discipline applies: NEVER reorder fields, NEVER
// reuse a removed field id; all fields carry an explicit `(id: N)`. Ids are
// assigned consecutively starting at 0 (flatc requirement) and are frozen.
//
// The design must express both DES queueing models (e.g. the mm1 example) and
// ABM models; EquationModel is a semantic placeholder until Phase 5.

namespace logicpilot.ir;

// Declare the attributes used below (flatc requires attributes to be
// declared before use once any of them is given explicitly).
attribute "id";
attribute "default";

// ---------------------------------------------------------------------------
// Scalars / enums
// ---------------------------------------------------------------------------

// IR schema version. Bumped only through the freeze process (F1 = 1).
// Mirrored by ModelFile.schema_version.
enum IrSchemaVersion : uint32 { V1 = 1 }

enum PortDirection : byte { Input = 0, Output = 1, InOut = 2 }

// Parameter value kinds (union members live below as tables).
enum DistributionKind : byte {
  Constant = 0,
  Uniform = 1,      // params: [min, max]
  Normal = 2,       // params: [mean, stddev]
  Exponential = 3,  // params: [rate]
  Poisson = 4       // params: [rate]
}

enum TimeAdvanceKind : byte {
  Constant = 0,      // value holds the fixed lifetime
  Distribution = 1,  // distribution holds the sampling law
  Expression = 2,    // expression_text placeholder (lowered later)
  Infinite = 3       // ta() = infinity (passive model)
}

enum QueueDiscipline : byte { Fifo = 0, Lifo = 1, Priority = 2 }

// ---------------------------------------------------------------------------
// Supporting types
// ---------------------------------------------------------------------------

// Source location in the originating DSL file (1-based line/column, byte
// offset/length into the file). All fields optional; 0 = unknown.
table SourceSpan {
  line: uint32 (id: 0);
  column: uint32 (id: 1);
  byte_offset: uint32 (id: 2);
  byte_length: uint32 (id: 3);
}

// Provenance attached to every model node and to the file itself.
table Metadata {
  name: string (id: 0);
  version: string (id: 1);
  source_file: string (id: 2);
  span: SourceSpan (id: 3);
}

// Named ports on atomic/coupled models.
table Port {
  name: string (id: 0);
  direction: PortDirection (id: 1);
  // Optional payload schema name carried on this port (best effort in v1).
  event_type: string (id: 2);
}

// A directed coupling between child ports inside a CoupledModel, or between
// a child port and a parent port when `from_model`/`to_model` names the
// parent ("." is reserved for the enclosing model).
table Coupling {
  from_model: string (id: 0);
  from_port: string (id: 1);
  to_model: string (id: 2);
  to_port: string (id: 3);
}

// Sampling distributions used by params, arrivals and service times.
table Distribution {
  kind: DistributionKind (id: 0);
  // Positional parameters; meaning per kind (see DistributionKind above).
  params: [double] (id: 1);
}

// Typed parameter values. The union keeps Param open for evolution.
table IntValue { value: long (id: 0); }
table FloatValue { value: double (id: 0); }
table BoolValue { value: bool (id: 0); }
table StringValue { value: string (id: 0); }

union ParamValue {
  IntValue,
  FloatValue,
  BoolValue,
  StringValue,
  Distribution,
}

table Param {
  name: string (id: 0);
  // Union fields reserve id-1 for the implicit `value_type` tag.
  value: ParamValue (id: 2);
}

// Reference to a state machine definition owned by the agent runtime
// (full definitions are resolved by the kernel, the IR only carries the ref).
table StateMachineRef {
  name: string (id: 0);
  initial_state: string (id: 1);
  params: [Param] (id: 2);
}

// Event payloads: either opaque bytes or a structured bag of named values.
table RawEvent { data: [ubyte] (id: 0); }
table StructEvent { fields: [Param] (id: 0); }

union EventValue { RawEvent, StructEvent }

table EventPayload {
  name: string (id: 0);
  // Union fields reserve id-1 for the implicit `value_type` tag.
  value: EventValue (id: 2);
}

// ---------------------------------------------------------------------------
// DEVS atomic building blocks
// ---------------------------------------------------------------------------

// Description of the time advance function ta().
table TimeAdvance {
  kind: TimeAdvanceKind (id: 0);
  value: double (id: 1);
  distribution: Distribution (id: 2);
  expression_text: string (id: 3);
}

// Description of an external (delta_ext) or internal (delta_int) transition.
// v1 carries descriptive data + an opaque handler reference; the executable
// lowering is produced by later phases.
table TransitionSpec {
  description: string (id: 0);
  // External transitions: input port that triggers; empty for internal.
  trigger_port: string (id: 1);
  // Output port produced by this transition (if any).
  output_port: string (id: 2);
  handler_ref: string (id: 3);
  effects: [Param] (id: 4);
}

// ---------------------------------------------------------------------------
// The five model kinds
// ---------------------------------------------------------------------------

// Classic DEVS atomic: state, ta(), delta_ext/delta_int, I/O ports.
table AtomicModel {
  metadata: Metadata (id: 0);
  // Initial state variables (name/value pairs).
  state: [Param] (id: 1);
  ta: TimeAdvance (id: 2);
  external_transition: TransitionSpec (id: 3);
  internal_transition: TransitionSpec (id: 4);
  input_ports: [Port] (id: 5);
  output_ports: [Port] (id: 6);
  params: [Param] (id: 7);
}

// DEVS coupled container: children + coupling table. Children are `Model`
// wrappers so coupling trees nest arbitrarily deep.
table CoupledModel {
  metadata: Metadata (id: 0);
  children: [Model] (id: 1);
  couplings: [Coupling] (id: 2);
  params: [Param] (id: 3);
}

// Agent component instance (capabilities/sensors/actuators attached to an
// agent). Kept open via params in v1.
table AgentComponent {
  name: string (id: 0);
  component_type: string (id: 1);
  params: [Param] (id: 2);
}

// Behavior rule of an agent.
table Behavior {
  name: string (id: 0);
  trigger: string (id: 1);
  handler_ref: string (id: 2);
  params: [Param] (id: 3);
}

// ABM agent definition: components + behaviors + optional state machine.
table AgentModel {
  metadata: Metadata (id: 0);
  components: [AgentComponent] (id: 1);
  behaviors: [Behavior] (id: 2);
  state_machine: StateMachineRef (id: 3);
  state: [Param] (id: 4);
  params: [Param] (id: 5);
}

// Process-network nodes for DES queueing models (mm1 etc.).
table SourceNode {
  arrival: Distribution (id: 0);
  // -1 = unbounded arrivals.
  max_arrivals: long (id: 1, default: -1);
}

table QueueNode {
  capacity: long (id: 0);
  discipline: QueueDiscipline (id: 1);
}

table ServiceNode {
  service_time: Distribution (id: 0);
  // Name of the resource this service draws capacity from ("" = none).
  resource: string (id: 1);
  servers: long (id: 2, default: 1);
}

table SinkNode { }

table DelayNode {
  delay: Distribution (id: 0);
}

union ProcessNodeKind {
  SourceNode,
  QueueNode,
  ServiceNode,
  SinkNode,
  DelayNode,
}

table ProcessNode {
  name: string (id: 0);
  // Union fields reserve id-1 for the implicit `kind_type` tag.
  kind: ProcessNodeKind (id: 2);
}

// A process flow: ordered/tagged nodes wired by couplings (dsl-spec.md §2:
// source → queue(s) → service(s); sink terminates the flow).
table ProcessModel {
  metadata: Metadata (id: 0);
  nodes: [ProcessNode] (id: 1);
  couplings: [Coupling] (id: 2);
  params: [Param] (id: 3);
}

// Equation-based (system dynamics) model — SEMANTIC PLACEHOLDER until
// Phase 5. Variables/equations are stored verbatim; nothing interprets them
// yet. Equations are opaque strings in v1 by design.
table EquationVariable {
  name: string (id: 0);
  initial_value: double (id: 1);
  unit: string (id: 2);
}

table EquationModel {
  metadata: Metadata (id: 0);
  variables: [EquationVariable] (id: 1);
  // Opaque equation text, one entry per equation.
  equations: [string] (id: 2);
  params: [Param] (id: 3);
}

// ---------------------------------------------------------------------------
// Polymorphic model wrapper + file root
// ---------------------------------------------------------------------------

union ModelKind {
  AtomicModel,
  CoupledModel,
  AgentModel,
  ProcessModel,
  EquationModel,
}

// Recursive polymorphic node: the unit of composition for model trees.
table Model {
  // Union fields reserve id-1 for the implicit `kind_type` tag.
  kind: ModelKind (id: 1);
}

// Top-level root of every .lpir file (F1).
table ModelFile {
  schema_version: uint32 (id: 0, default: 1);
  root: Model (id: 1);
  // File-level parameter table (simulation seed, horizon, ...).
  params: [Param] (id: 2);
  metadata: Metadata (id: 3);
}

root_type ModelFile;
file_identifier "LPIR";
file_extension "lpir";
