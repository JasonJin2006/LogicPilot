// IR v2 - thin Node container + semantics references (library registry).
// Wired into the build and frozen (baseline copy in schemas/baseline/):
// `lpcli compile` emits this contract by default (file_identifier "LP2R");
// the v1 contract (schemas/ir.fbs) remains a pure compatibility layer.
// Migration design: docs/specs/ir-v2.md.

namespace logicpilot.ir.v2;

enum VarType : byte { Bool = 0, Int = 1, Float = 2, String = 3, Distribution = 4 }
enum PortDirection : byte { Input = 0, Output = 1, InOut = 2 }
enum TriggerKind : byte { Timeout = 0, Rate = 1, Message = 2, Condition = 3 }
enum ExperimentKind : byte {
  Simulation = 0,
  Optimization = 1,
  MonteCarlo = 2,
  ParameterVariation = 3
}

enum SeedPolicy : byte { Fixed = 0, Random = 1 }
enum ReplicationPolicy : byte { Fixed = 0, Precision = 1 }

table SourceSpan {
  line: uint32;
  column: uint32;
  byte_offset: uint32;
  byte_length: uint32;
}

table Metadata {
  name: string;
  version: string;
  source_file: string;
  span: SourceSpan;
}

table Distribution {
  kind: byte;
  params: [double];
}

// Typed variable: replaces the v1 Param magic bag. Exactly one value field
// is meaningful per `type`.
table Var {
  name: string;
  type: VarType;
  bool_value: bool;
  int_value: long;
  float_value: double;
  string_value: string;
  distribution: Distribution;
}

table Port {
  name: string;
  direction: PortDirection;
  // Typed message channel: reuses the F2 wire schema names (e.g. "Job").
  event_type: string;
}

// Semantics reference: the runtime engine registry looks up { library, block }
// (AnyLogic palette / FMI FMU interface idea). `params` are typed block
// parameters (e.g. resource name, capacity, failure rate).
table SemanticsRef {
  library: string;
  block: string;
  version: string;
  params: [Var];
}

table Coupling {
  from_model: string;
  from_port: string;
  to_model: string;
  to_port: string;
}

// --- Statechart behavior data (replaces TransitionSpec magic bags) ---------
table State { name: string; }

table Action {
  set_state: string;
  set_value: Var;
  emit_port: string;
}

// Generic behavior binding (agent-style): trigger + kernel handler reference
// + typed params. Carries v1 AgentModel behaviors.
table BehaviorBinding {
  trigger: string;
  handler_ref: string;
  params: [Var];
}

table Transition {
  from: string;
  to: string;
  trigger: TriggerKind;
  timeout_value: double;
  timeout_distribution: Distribution;  // distribution ta (e.g. exponential)
  rate: double;
  message_port: string;
  condition_text: string;
  actions: [Action];
}

table Statechart {
  states: [State];
  transitions: [Transition];
  initial: string;
}

// Structured continuous equations (SD / physics), NOT a string bag. v0 RHS
// grammar: numbers, identifiers (params + state vars), + - * / and
// parentheses (e.g. "-k*y", "r*y*(1-y/K)").
table Equation {
  lhs: string;
  rhs_text: string;
  initial_value: double;
}

// Opaque, versioned data owned by a modeling-method plugin. The core IR keeps
// topology, lifecycle, and typed ports stable while specialized paradigms can
// attach meshes, tensors, GIS layers, FMU metadata, solver hints, and future
// structures without adding a hard-coded table for every method.
table ExtensionPayload {
  type_uri: string;       // globally stable owner/type identifier
  schema_version: uint32;
  encoding: string;       // e.g. "flatbuffers", "json", "cbor", "fmu"
  data: [ubyte];
}

// The one container: children + couplings + behavior + continuous, with the
// executable semantics delegated to a registered engine via `semantics`.
table Node {
  metadata: Metadata;
  state: [Var];
  params: [Var];
  ports: [Port];
  semantics: SemanticsRef;
  children: [Node];
  couplings: [Coupling];
  behavior: Statechart;
  behaviors: [BehaviorBinding];
  continuous: [Equation];
  extensions: [ExtensionPayload];
}

// Experiments are part of the model (v1 keeps them as a compile sidecar
// until Phase B; v2 carries them natively).
table VariationAxis {
  name: string;
  variable: string;
  range_min: double;
  range_max: double;
  step: double = 1.0;
}

table Experiment {
  kind: ExperimentKind;
  name: string;
  variable: string;
  objective: string;      // "maximize" | "minimize"
  metric: string;         // "throughput" | "Wq" | "W" | "Lq" | ...
  range_min: double;
  range_max: double;
  budget: uint32;
  replications: uint32;
  seed: uint64;
  seed_policy: SeedPolicy = Fixed;
  replication_policy: ReplicationPolicy = Fixed;
  min_replications: uint32 = 5;
  max_replications: uint32 = 100;
  confidence: double = 0.95;
  error_percent: double = 5.0;
  precision_metric: string;
  axes: [VariationAxis];
}

table ModelFile {
  schema_version: uint32;
  root: Node;
  experiments: [Experiment];
  metadata: Metadata;
}

root_type ModelFile;
// Distinct identifier so load_model_buffer can auto-detect the contract
// version without schema-ambiguous verification (v1 keeps "LPIR").
file_identifier "LP2R";
file_extension "lpir";
