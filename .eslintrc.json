{
  "root": true,
  "env": {
    "browser": true,
    "es2022": true,
    "node": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "extends": ["eslint:recommended"],
  "overrides": [
    {
      "files": ["web/apps/ide/src/workbench/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": ["error",
          {
            "patterns": [
              {
                "group": ["../sysml", "../sysml/**", "../model", "../model/**"],
                "message": "workbench platform must not import paradigm modules (ADR-0068); consume through the registries."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/*.ts", "**/*.tsx"],
      "parser": "@typescript-eslint/parser",
      "plugins": ["@typescript-eslint"],
      "extends": [
        "eslint:recommended",
        "plugin:@typescript-eslint/recommended"
      ]
    }
  ],
  "rules": {
    "no-console": "warn",
    "prefer-const": "error",
    "eqeqeq": ["error", "smart"]
  },
  "ignorePatterns": ["dist/", "node_modules/", "build/", "*.generated.*"]
}
