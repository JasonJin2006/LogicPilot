{
  "model": "des-queue-fifo",
  "description": "FIFO serves Low before High; High exits through timeout.",
  "blocks": [
    {
      "name": "Buffer",
      "kind": "queue",
      "metrics": {
        "departed_mean": { "value": 2, "abs_tol": 0 },
        "timed_out_mean": { "value": 1, "abs_tol": 0 },
        "mean_occupancy": { "value": 0.95, "abs_tol": 1e-6 }
      }
    },
    { "name": "OtherServed", "kind": "sink", "metrics": { "departed_mean": { "value": 2, "abs_tol": 0 } } },
    { "name": "HighServed", "kind": "sink", "metrics": { "departed_mean": { "value": 0, "abs_tol": 0 } } },
    { "name": "LowTimedOut", "kind": "sink", "metrics": { "departed_mean": { "value": 0, "abs_tol": 0 } } },
    { "name": "HighTimedOut", "kind": "sink", "metrics": { "departed_mean": { "value": 1, "abs_tol": 0 } } }
  ]
}
