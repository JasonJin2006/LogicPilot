{
  "name": "logicpilot",
  "version": "0.0.1",
  "private": true,
  "description": "LogicPilot simulation OS monorepo root",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "benchmark:assistant": "node scripts/benchmark-ai-assistant.mjs",
    "benchmark:paradigms": "node scripts/benchmark-ai-paradigms.mjs",
    "build": "pnpm -r run build",
    "check:contracts": "node scripts/check-contract-conform.mjs",
    "check:kernel-boundary": "node scripts/check-kernel-boundary.mjs",
    "codegen": "node scripts/codegen-ts.mjs",
    "component-runner:build": "node scripts/build-component-runner.mjs",
    "contracts:wit": "node scripts/check-wit-contract.mjs",
    "desktop:bundle": "pnpm desktop:stage && pnpm desktop:test-staged && pnpm exec tauri build --ci --config desktop/src-tauri/tauri.conf.json",
    "desktop:stage": "pnpm --filter @logicpilot/plugin-catalog build && pnpm --filter @logicpilot/ide build && pnpm component-runner:build && node scripts/stage-desktop-runtime.mjs",
    "desktop:test-staged": "node scripts/test-staged-desktop-runtime.mjs --stage build/desktop-runtime",
    "dev": "pnpm --filter @logicpilot/ide run dev",
    "docs:build": "vitepress build docs",
    "docs:dev": "vitepress dev docs",
    "docs:preview": "vitepress preview docs",
    "format": "prettier --write \"web/**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"web/**/*.{ts,tsx,json,md}\"",
    "lint": "eslint \"web/**/*.{ts,tsx}\"",
    "lint:ci": "eslint \"web/**/*.{ts,tsx}\" --max-warnings=0",
    "test": "node scripts/check-wit-contract.mjs && node scripts/check-kernel-boundary.mjs && node scripts/test-kernel-boundary.mjs && node scripts/test-tool-paths.mjs && node scripts/test-request-policy.mjs && node scripts/test-ai-provider-config.mjs && node scripts/test-agent-skills.mjs && node scripts/test-mcp-client.mjs && node scripts/test-ai-provider-endpoint.mjs && node scripts/test-ai-assistant.mjs && node scripts/test-codex-assistant-provider.mjs && node scripts/test-ai-assistant-benchmark.mjs && node scripts/test-ai-paradigm-benchmark.mjs && pnpm -r run test",
    "test:app-server": "node scripts/test-app-server.mjs",
    "test:browser": "node scripts/test-browser-e2e.mjs",
    "test:execution": "node scripts/test-execution-boundary.mjs",
    "test:kernel-supervisor": "node scripts/test-kernel-supervisor.mjs",
    "test:modeling-cases": "node scripts/verify-modeling-cases.mjs",
    "test:node-runtime-e2e": "pnpm --filter @logicpilot/plugin-catalog build && node scripts/test-node-runtime-e2e.mjs",
    "test:paradigm-lifecycle": "pnpm --filter @logicpilot/ide run verify:paradigm-lifecycle",
    "test:plugin-lifecycle": "node scripts/test-plugin-lifecycle.mjs",
    "test:runtime-adapters": "node scripts/test-runtime-adapters.mjs",
    "test:runtime-conformance": "node scripts/test-runtime-conformance.mjs",
    "test:scene3d-browser": "node scripts/test-scene3d-browser.mjs",
    "test:session-host": "node scripts/test-session-host.mjs",
    "test:zero-paradigm": "pnpm --filter @logicpilot/ide run verify:zero-paradigm",
    "typecheck": "pnpm -r run typecheck"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@typescript-eslint/eslint-plugin": "^8.29.0",
    "@typescript-eslint/parser": "^8.29.0",
    "eslint": "^8.57.1",
    "prettier": "^3.5.3",
    "vitepress": "^1.6.4"
  },
  "engines": {
    "node": ">=20"
  }
}
