{
  "name": "logicpilot",
  "version": "0.0.1",
  "private": true,
  "description": "LogicPilot simulation OS monorepo root",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "codegen": "node scripts/codegen-ts.mjs",
    "format": "prettier --write \"web/**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"web/**/*.{ts,tsx,json,md}\"",
    "lint": "eslint \"web/**/*.{ts,tsx}\"",
    "test": "node scripts/test-tool-paths.mjs && node scripts/test-request-policy.mjs && node scripts/test-ai-provider-config.mjs && node scripts/test-agent-skills.mjs && node scripts/test-mcp-client.mjs && node scripts/test-ai-provider-endpoint.mjs && node scripts/test-ai-assistant.mjs && node scripts/test-codex-assistant-provider.mjs && node scripts/test-ai-assistant-benchmark.mjs && node scripts/test-ai-paradigm-benchmark.mjs && pnpm -r run test",
    "benchmark:assistant": "node scripts/benchmark-ai-assistant.mjs",
    "benchmark:paradigms": "node scripts/benchmark-ai-paradigms.mjs",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test:app-server": "node scripts/test-app-server.mjs",
    "test:browser": "node scripts/test-browser-e2e.mjs",
    "test:modeling-cases": "node scripts/verify-modeling-cases.mjs",
    "desktop:stage": "pnpm --filter @logicpilot/ide build && node scripts/stage-desktop-runtime.mjs",
    "desktop:test-staged": "node scripts/test-staged-desktop-runtime.mjs --stage build/desktop-runtime",
    "desktop:bundle": "pnpm desktop:stage && pnpm desktop:test-staged && pnpm exec tauri build --ci --config desktop/src-tauri/tauri.conf.json",
    "dev": "pnpm --filter @logicpilot/ide run dev",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@typescript-eslint/eslint-plugin": "^8.29.0",
    "@typescript-eslint/parser": "^8.29.0",
    "eslint": "^8.57.1",
    "prettier": "^3.5.3",
    "vitepress": "^1.6.4"
  },
  "engines": {
    "node": ">=20"
  }
}
