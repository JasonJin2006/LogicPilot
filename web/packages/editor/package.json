{
  "name": "@logicpilot/editor",
  "version": "0.0.1",
  "private": true,
  "description": "LogicPilot drag-and-drop modeling core: block graph document, operations and DSL v2 generation",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/bundle.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "bundle": "node scripts/bundle.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^3.1.3",
    "esbuild": "^0.25.12"
  },
  "dependencies": {
    "polygon-clipping": "^0.15.7",
    "@logicpilot/contracts": "workspace:*"
  }
}
