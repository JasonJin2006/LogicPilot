{
  "name": "@logicpilot/renderer2d",
  "version": "0.0.1",
  "private": true,
  "description": "LogicPilot 2D visualization toolkit: pure wire-frame decoding (Worker-ready) shared by the browser IDE",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@logicpilot/protocol": "workspace:*",
    "flatbuffers": "25.9.23"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^3.1.3"
  }
}
