{
  "name": "@logicpilot/protocol",
  "version": "0.0.1",
  "private": true,
  "description": "LogicPilot FlatBuffers protocol bindings: ir.fbs (F1) and wire.fbs (F2), generated by flatc",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "codegen": "node ../../../scripts/codegen-ts.mjs",
    "build": "tsc -p tsconfig.json",
    "test": "node test/verify-interop.mjs"
  },
  "dependencies": {
    "flatbuffers": "25.9.23"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
