{
  "schema": "logicpilot.plugin-contributions/v1",
  "contractVersion": 1,
  "pluginId": "logicpilot.des",
  "version": "1.0.0",
  "knowledge": [
    {
      "schema": "logicpilot.knowledge-block/v1",
      "contractVersion": 1,
      "id": "logicpilot.des.queueing.core",
      "version": "1.0.0",
      "owner": "logicpilot.des",
      "type": "concept",
      "classification": "plugin",
      "status": "trusted",
      "scope": { "paradigms": ["logicpilot-process"] },
      "provenance": {
        "source": "logicpilot.des",
        "reference": "builtin-conformance",
        "confidence": 1
      },
      "verification": { "method": "conformance-case", "cases": ["mm1"] },
      "content": {
        "model": "discrete-event-process",
        "semanticKinds": ["source", "queue", "service", "sink"],
        "invariants": ["connections are explicit", "queue capacity is non-negative"]
      }
    }
  ],
  "skills": [
    {
      "id": "logicpilot.des.skill.build-flow",
      "name": "Build a Process flow",
      "trigger": "user asks to construct or repair a Process/DSL flow",
      "inputs": ["model", "diagnostics"],
      "steps": [
        { "id": "logicpilot.des.skill.inspect", "action": "inspect_model" },
        { "id": "logicpilot.des.skill.patch", "action": "apply_model_patch" },
        { "id": "logicpilot.des.skill.compile", "action": "compile_model" }
      ],
      "permissions": []
    }
  ],
  "instructions": [
    {
      "id": "logicpilot.des.instruction.safety",
      "scope": "logicpilot-process",
      "priority": 100,
      "rules": [
        "Use explicit typed patches for model changes.",
        "After mutation, compile and use returned diagnostics for repair."
      ],
      "forbidden": [
        "Do not invent simulation metrics.",
        "Do not silently clamp invalid capacity values."
      ]
    }
  ],
  "diagnostics": [
    {
      "schema": "logicpilot.diagnostic-definition/v1",
      "contractVersion": 1,
      "id": "LP2004",
      "pluginId": "logicpilot.des",
      "titleKey": "diagnostic.logicpilot.des.unknown-block",
      "defaultSeverity": "error",
      "fixIds": [],
      "appliesToParadigms": ["logicpilot-process"],
      "conformanceCases": ["unknown-block"]
    }
  ],
  "views": [
    {
      "schema": "logicpilot.view-definition/v1",
      "contractVersion": 1,
      "id": "logicpilot.des.flow-view",
      "owner": "logicpilot.des",
      "titleKey": "view.logicpilot.des.flow",
      "canvas": "flow",
      "query": { "artifactKinds": ["semantic-model"], "relationKinds": ["projects", "provides"] },
      "projection": { "semantic": "process-flow", "layout": "orthogonal" },
      "interactions": ["select", "create", "connect", "inline-edit"],
      "supportsInverseEdit": true,
      "layoutPersistence": "artifact"
    }
  ],
  "notations": [
    {
      "schema": "logicpilot.notation-pack/v1",
      "contractVersion": 1,
      "id": "logicpilot.des.flow-notation",
      "owner": "logicpilot.des",
      "glyphs": [
        { "semanticKind": "source", "glyph": "source" },
        { "semanticKind": "queue", "glyph": "queue" },
        { "semanticKind": "service", "glyph": "service" },
        { "semanticKind": "sink", "glyph": "sink" }
      ],
      "edges": [{ "relationKind": "projects", "edgeStyle": "orthogonal", "directed": true }],
      "createActions": [
        { "id": "logicpilot.des.create.source", "order": 10 },
        { "id": "logicpilot.des.create.queue", "order": 20 },
        { "id": "logicpilot.des.create.service", "order": 30 }
      ]
    }
  ],
  "createActions": [
    {
      "schema": "logicpilot.create-action/v1",
      "contractVersion": 1,
      "id": "logicpilot.des.create.source",
      "owner": "logicpilot.des",
      "titleKey": "create.process.source",
      "notationId": "logicpilot.des.flow-notation",
      "targetSemanticKind": "source",
      "order": 10
    },
    {
      "schema": "logicpilot.create-action/v1",
      "contractVersion": 1,
      "id": "logicpilot.des.create.queue",
      "owner": "logicpilot.des",
      "titleKey": "create.process.queue",
      "notationId": "logicpilot.des.flow-notation",
      "targetSemanticKind": "queue",
      "order": 20
    },
    {
      "schema": "logicpilot.create-action/v1",
      "contractVersion": 1,
      "id": "logicpilot.des.create.service",
      "owner": "logicpilot.des",
      "titleKey": "create.process.service",
      "notationId": "logicpilot.des.flow-notation",
      "targetSemanticKind": "service",
      "order": 30
    }
  ],
  "palettes": [
    {
      "id": "logicpilot.des.palette",
      "canvas": "flow",
      "itemKind": "source",
      "label": "Source",
      "semanticType": "process.source",
      "defaults": { "type": "object" }
    },
    {
      "id": "logicpilot.des.palette.queue",
      "canvas": "flow",
      "itemKind": "queue",
      "label": "Queue",
      "semanticType": "process.queue",
      "defaults": { "type": "object" }
    },
    {
      "id": "logicpilot.des.palette.service",
      "canvas": "flow",
      "itemKind": "service",
      "label": "Service",
      "semanticType": "process.service",
      "defaults": { "type": "object" }
    }
  ],
  "tools": [],
  "runParameters": [
    {
      "id": "metric",
      "label": "precision metric",
      "kind": "text",
      "owner": "model",
      "hint": "The stopping metric a precision replication count targets. It is declared in the model's experiment block (metric = ...); these are the names this paradigm recognises.",
      "choices": [
        { "value": "Wq" },
        { "value": "W" },
        { "value": "Lq" },
        { "value": "L" },
        { "value": "throughput" },
        { "value": "utilization" },
        { "value": "availability" }
      ]
    },
    {
      "id": "arrivals",
      "label": "arrivals",
      "kind": "integer",
      "owner": "run",
      "minimum": 1,
      "hint": "Termination for this run: stop after this many arrivals."
    },
    {
      "id": "warmup",
      "label": "warmup",
      "kind": "integer",
      "owner": "run",
      "minimum": 0,
      "hint": "Entities to discard before statistics start accumulating."
    }
  ]
}
