{
  "name": "@logicpilot/ide",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "LogicPilot browser IDE: drag-modeling canvas, DSL compile, live simulation viz, AI copilot panel and project system",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "gen:cursors": "node scripts/gen-cursors.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "verify:headless": "node scripts/headless-verify.mjs",
    "verify:browser": "node scripts/browser-verify.mjs",
    "verify:ui": "node scripts/ui-snapshot.mjs",
    "verify:ui:runtime": "node scripts/ui-snapshot.mjs --runtime",
    "verify:zero-paradigm": "node scripts/zero-paradigm-verify.mjs",
    "verify:paradigm-lifecycle": "node scripts/paradigm-lifecycle-verify.mjs"
  },
  "dependencies": {
    "@logicpilot/canvas": "workspace:*",
    "@logicpilot/contracts": "workspace:*",
    "@logicpilot/editor": "workspace:*",
    "@logicpilot/plugin-host": "workspace:*",
    "@logicpilot/protocol": "workspace:*",
    "@logicpilot/renderer2d": "workspace:*",
    "@logicpilot/scene3d": "workspace:*",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "elkjs": "0.9.2",
    "lucide-react": "^1.28.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.186.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.4.1",
    "playwright-core": "^1.62.1",
    "typescript": "^5.6.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.3"
  }
}
